@article{eliasonHowAcquisitionsAffect2020,
  title = {How {{Acquisitions Affect Firm Behavior}} and {{Performance}}: {{Evidence}} from the {{Dialysis Industry}}*},
  shorttitle = {How {{Acquisitions Affect Firm Behavior}} and {{Performance}}},
  author = {Eliason, Paul J and Heebsh, Benjamin and McDevitt, Ryan C and Roberts, James W},
  year = {2020},
  month = feb,
  journal = {The Quarterly Journal of Economics},
  volume = {135},
